{
  "name": "swingkings",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && vitest run --project unit && next build && prisma migrate deploy",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "e2e": "npm run e2e:build && playwright test",
    "e2e:build": "prisma generate && next build",
    "e2e:report": "playwright show-report",
    "db:check": "node scripts/check-schema-drift.mjs",
    "db:migrate": "prisma migrate dev",
    "verify": "npm run lint && npm run typecheck && npm run db:check && npm test && npm run e2e",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo": "tsx scripts/demo-seed.mts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/client": "6.19.3",
    "@supabase/realtime-js": "^2.117.2",
    "@vercel/analytics": "^2.0.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "next": "15.5.29",
    "prisma": "6.19.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.29",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^7",
    "vitest": "^5.0.0"
  }
}
