# Postgres. On Vercel with Supabase: DATABASE_URL is the pooled connection (port 6543,
# ?pgbouncer=true), DIRECT_URL the direct one used by migrations. Locally both are the same.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swingkings
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/swingkings

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Any random string; Vercel Cron sends it to /api/cron/daily.
CRON_SECRET=

# Push notifications: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: live chat through Supabase Realtime. All four or none — without them the chat polls.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Used once, by `npm run db:seed`, to create the first super admin.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=
