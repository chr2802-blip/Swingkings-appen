generator client {
  provider        = "prisma-client-js"
  // One SQL statement per read, nested relations included, instead of one per level:
  // every round trip to the database is paid in latency on each page.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Pooled connection, used at runtime by serverless functions.
  url       = env("DATABASE_URL")
  // Unpooled connection; migrations need a direct session. Locally both are the same.
  directUrl = env("DIRECT_URL")
}

/// What somebody may do across the whole installation: look after every team, or not.
enum PlatformRole {
  SUPER_ADMIN
  USER
}

/**
 * What somebody may do on one team. Answered per team, on TeamMember, because the
 * treasurer of the first team can be an ordinary player on the second.
 * ADMIN     træner/holdleder: everything, including members, matches and settings.
 * TREASURER bødekasseformand: the fine catalogue, others' fines, resetting and withdrawing.
 * PLAYER    everybody else: challenges, tasks, chat and the feed.
 */
enum MemberRole {
  ADMIN
  TREASURER
  PLAYER
}

/// The colour a team is dressed in. What each one looks like lives in globals.css.
enum TeamTheme {
  SWINGKINGS
  GREEN
  BLUE
  RED
  BLACK
  ORANGE
  PURPLE
}

/// Where a calendar entry came from: typed in here, or read from DBU KampKlar's feed.
enum MatchSource {
  MANUAL
  KAMPKLAR
}

/// KampKlar's feed holds every activity on the team; only some of them are matches.
enum ActivityKind {
  MATCH
  TRAINING
  OTHER
}

/**
 * Where a challenge is. A challenge is reported once it has been played — who won, who
 * lost, how many fines it was for — and goes through when somebody else approves it:
 * the stake moves from the winner's fines to the loser's.
 * PENDING   reported, waiting for anybody but the reporter to approve it
 * SETTLED   approved; the fines have moved
 * CANCELLED withdrawn by the reporter or the treasurer, or undone afterwards
 */
enum ChallengeStatus {
  PENDING
  SETTLED
  CANCELLED
}

model Team {
  id               String    @id @default(cuid())
  name             String
  photoId          String?
  theme            TeamTheme @default(SWINGKINGS)
  /**
   * What one fine (én bøde) costs in kroner. A fine type costs a number of these, so
   * "for sent til træning" can be 2 bøder and "rødt kort" 10. Each Fine copies the
   * price as it was when it was given, so changing this never rewrites what somebody
   * already owes.
   */
  finePriceKr      Int       @default(10)
  /**
   * The team's calendar link from DBU KampKlar ("Eksporter kalender"): an iCalendar
   * feed, read by the sync on the matches page and by the daily job.
   */
  calendarUrl      String?
  /// When the calendar was last read successfully.
  calendarSyncedAt DateTime?
  /// Made by "Opret testhold" (`src/lib/demo-team.ts`); the only team "Slet testhold" removes.
  isDemo           Boolean   @default(false)
  /**
   * When the current season began ("Start ny sæson", `src/lib/season.ts`); null until the
   * first, when the season counts from `createdAt`. The KampKlar sync brings nothing back
   * from before it.
   */
  seasonStartedAt  DateTime?
  createdAt        DateTime  @default(now())

  members         TeamMember[]
  activeFor       User[]           @relation("ActiveTeam")
  inviteLinks     InviteLink[]
  fineTypes       FineType[]
  fines           Fine[]
  challenges      Challenge[]
  matches         Match[]
  tasks           Task[]
  taskTemplates   TaskTemplate[]
  chatMessages    ChatMessage[]
  posts           Post[]
  polls           Poll[]
  activitySignups ActivitySignup[]
  seasons         Season[]
  photos          Photo[]          @relation("PhotoTeam")
  photo           Photo?           @relation("TeamPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  @@index([photoId])
}

/**
 * One person, who may be on any number of teams. `activeTeamId` is only which of them
 * is on screen; what they may reach is answered from `memberships`.
 */
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  /// Bumped when the password changes; a session cookie naming an older version is dead.
  tokenVersion Int          @default(0)
  role         PlatformRole @default(USER)
  activeTeamId String?
  photoId      String?
  /// One of the demo team's made-up players; removed together with it, and nobody else is.
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())

  activeTeam         Team?              @relation("ActiveTeam", fields: [activeTeamId], references: [id], onDelete: SetNull)
  photo              Photo?             @relation("UserPhoto", fields: [photoId], references: [id], onDelete: SetNull)
  memberships        TeamMember[]
  pushSubscriptions  PushSubscription[]
  inviteLinksCreated InviteLink[]       @relation("InviteLinkCreatedBy")

  finesReceived Fine[] @relation("FinePlayer")
  finesIssued   Fine[] @relation("FineIssuedBy")

  challengesReported Challenge[] @relation("ChallengeReportedBy")
  challengesWon      Challenge[] @relation("ChallengeWinner")
  challengesLost     Challenge[] @relation("ChallengeLoser")
  challengesApproved Challenge[] @relation("ChallengeApprovedBy")

  tasksCreated Task[]         @relation("TaskCreatedBy")
  tasksDone    Task[]         @relation("TaskDoneBy")
  taskAssigned TaskAssignee[]

  chatMessages ChatMessage[]
  posts        Post[]
  pollOptions  PollOption[]     @relation("PollOptionPlayer")
  pollVotes    PollVote[]       @relation("PollVoter")
  pollBallots  PollBallot[]     @relation("PollBallot")
  signups      ActivitySignup[]
  postLikes    PostLike[]
  postComments PostComment[]

  @@index([activeTeamId])
  @@index([photoId])
}

/// One person on one team, and what they may do there.
model TeamMember {
  userId      String
  teamId      String
  role        MemberRole @default(PLAYER)
  /// Shirt number, shown beside the name. Optional: not everybody on a team plays.
  shirtNumber Int?
  /**
   * Whether the automatic task distribution may hand this person jobs. A coach who
   * never washes the kit can be on the team without being picked for it.
   */
  takesTasks  Boolean    @default(true)
  /// When this person last had the feed in view; posts after it are "nye opslag".
  feedSeenAt  DateTime?
  /// When an admin marked this season's kontingent (membership fee) paid; null while it is not. A new season clears it.
  duesPaidAt  DateTime?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@index([teamId])
}

/**
 * A link that lets people sign up and join a team (`/join/<token>`). The admin posts it
 * wherever the team talks; whoever opens it creates an account, or joins with the one
 * they have. Only a hash of the token is stored, so the link is shown once. A link
 * carries no role: everybody joins as a player, and an admin gives roles afterwards.
 * `maxUses` is the hard limit on how many people one link can bring in, so a link that
 * escapes the group chat cannot become an account factory. `uses` is only ever raised
 * through a guarded update that compares it with `maxUses` (`redeemInviteLink`).
 */
model InviteLink {
  id          String   @id @default(cuid())
  teamId      String
  tokenHash   String   @unique
  maxUses     Int
  uses        Int      @default(0)
  expiresAt   DateTime
  createdById String
  createdAt   DateTime @default(now())

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User @relation("InviteLinkCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([createdById])
}

/**
 * An entry in the team's fine catalogue (bødekataloget): what it is for and how many
 * fines it costs. Archived rather than deleted once used, so the history keeps its name.
 */
model FineType {
  id          String    @id @default(cuid())
  teamId      String
  name        String
  description String?
  /// How many fines (bøder) this costs. One fine is `Team.finePriceKr` kroner.
  units       Int
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  team  Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fines Fine[]

  @@index([teamId])
}

/**
 * A fine somebody has been given. It copies the type's name, the number of fines and
 * the price of one at the moment it was given: the catalogue and the price can change
 * afterwards without changing what this person owes.
 * Nobody pays. A fine is outstanding until it is cleared (`clearedAt`), which the
 * treasurer does when he or she nulstiller somebody, or until the player has challenged
 * it away: winning a challenge writes the winner a fine with negative `units` and the
 * loser one with positive, so the stake moves from one to the other.
 */
model Fine {
  id          String    @id @default(cuid())
  teamId      String
  playerId    String
  fineTypeId  String?
  /// What it was for, as the catalogue called it then (or written freely).
  reason      String
  note        String?
  units       Int
  unitPriceKr Int
  issuedById  String
  matchId     String?
  /// The challenge this fine came from: the loser's (positive) and the winner's (negative).
  challengeId String?
  /// When the treasurer reset (nulstillede) it. A cleared fine is history, not owed.
  clearedAt   DateTime?
  createdAt   DateTime  @default(now())

  team      Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    User       @relation("FinePlayer", fields: [playerId], references: [id], onDelete: Cascade)
  fineType  FineType?  @relation(fields: [fineTypeId], references: [id], onDelete: SetNull)
  issuedBy  User       @relation("FineIssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)
  match     Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([playerId])
  @@index([fineTypeId])
  @@index([issuedById])
  @@index([matchId])
  @@index([challengeId])
  @@index([playerId, clearedAt])
}

/**
 * A challenge between two players, reported once it has been played. See ChallengeStatus
 * for its life and `src/lib/challenges.ts` for who may move it.
 */
model Challenge {
  id           String          @id @default(cuid())
  teamId       String
  description  String
  /// How many fines move from the winner to the loser.
  units        Int
  matchId      String?
  status       ChallengeStatus @default(PENDING)
  /// Who reported it — the winner or the loser. Anybody else may approve it.
  reportedById String
  winnerId     String
  loserId      String
  approvedById String?
  settledAt    DateTime?
  createdAt    DateTime        @default(now())

  team       Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  reportedBy User   @relation("ChallengeReportedBy", fields: [reportedById], references: [id], onDelete: Cascade)
  winner     User   @relation("ChallengeWinner", fields: [winnerId], references: [id], onDelete: Cascade)
  loser      User   @relation("ChallengeLoser", fields: [loserId], references: [id], onDelete: Cascade)
  approvedBy User?  @relation("ChallengeApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  match      Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  fines      Fine[]

  @@index([teamId, createdAt])
  @@index([reportedById])
  @@index([winnerId])
  @@index([loserId])
  @@index([approvedById])
  @@index([matchId])
}

/**
 * An activity (aktivitet) on the team's calendar: a match, a training, or anything else —
 * "Afslutningsfest", "Klubdag". The model keeps its old name; the app calls it an activity.
 * Either typed in, or read from the team's DBU KampKlar calendar feed, in which case
 * `externalUid` is the feed's own UID and the sync updates the row in place rather than
 * adding it twice. Every activity can have tasks.
 */
model Match {
  id          String       @id @default(cuid())
  teamId      String
  title       String
  opponent    String?
  kind        ActivityKind @default(MATCH)
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  /// Home or away, where it can be told; null when nobody knows.
  isHome      Boolean?
  note        String?
  source      MatchSource  @default(MANUAL)
  externalUid String?
  /// Set when the feed marks it cancelled or it disappears from the feed.
  cancelledAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  team       Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  tasks      Task[]
  fines      Fine[]
  challenges Challenge[]
  polls      Poll[]
  signups    ActivitySignup[]

  @@unique([teamId, externalUid])
  @@index([teamId, startsAt])
}

/**
 * A job somebody on the team has to do: wash the kit, bring fruit, drive. Belongs to an
 * activity; `dueAt` is the deadline and defaults to the activity's start. (Older tasks
 * may stand alone with a deadline of their own — new ones are always made on an activity.)
 */
model Task {
  id             String    @id @default(cuid())
  teamId         String
  title          String
  description    String?
  matchId        String?
  dueAt          DateTime?
  /// Null for a task the calendar sync added from a template rather than a person.
  createdById    String?
  doneAt         DateTime?
  doneById       String?
  /// When the reminder job last told the assignees, so they hear once a day at most.
  lastNotifiedAt DateTime?
  createdAt      DateTime  @default(now())

  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  match     Match?         @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdBy User?          @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  doneBy    User?          @relation("TaskDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  assignees TaskAssignee[]

  @@index([teamId, dueAt])
  @@index([matchId])
  @@index([createdById])
  @@index([doneById])
}

/// Who a task is handed to. Reached through its task, which carries the team.
model TaskAssignee {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

/**
 * A standard job ("Trøjevask", "Opkridtning"), set up with the calendar sync. Chosen when
 * an activity is made or later on its page, and — when `autoAdd` — added by the KampKlar
 * sync to every new match it brings in. Always handed out fairly.
 */
model TaskTemplate {
  id          String   @id @default(cuid())
  teamId      String
  title       String
  description String?
  /// How many people the job is handed to.
  people      Int      @default(1)
  /// Whether the KampKlar sync adds it to every new match by itself.
  autoAdd     Boolean  @default(true)
  createdAt   DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  teamId    String
  authorId  String
  body      String
  photoId   String?
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  photo  Photo? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([teamId, createdAt])
  @@index([authorId])
  @@index([photoId])
}

/**
 * A post on the team's feed: pictures, some words, a poll — any of them, at least one.
 * Its pictures are `PostPhoto` rows, in the order they were chosen.
 */
model Post {
  id        String   @id @default(cuid())
  teamId    String
  authorId  String
  body      String?
  createdAt DateTime @default(now())
  /// When the words or pictures were last changed after posting; the feed says "redigeret".
  editedAt  DateTime?
  /// Pinned posts lie at the top of the feed, the latest pinned first. Anybody on the team pins and unpins.
  pinnedAt  DateTime?

  team     Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  photos   PostPhoto[]
  poll     Poll?
  likes    PostLike[]
  comments PostComment[]

  @@index([teamId, createdAt])
  @@index([teamId, pinnedAt])
  @@index([authorId])
}

/// One of a post's pictures. Reached through its post.
model PostPhoto {
  postId   String
  photoId  String
  position Int

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([postId, photoId])
  @@index([photoId])
}

/**
 * A poll on a feed post: "Kampens spiller", "Hvornår skal vi holde fest?".
 * `anonymous` is decided when the poll is made and never changed afterwards. An
 * anonymous poll's votes carry no voter at all (`PollVote.voterId` is null) and no time,
 * and who has voted is kept apart in `PollBallot` — so nobody, admins included, can see
 * who voted for what, and a vote once cast cannot be changed (there is nothing linking
 * it to its voter to change). An open poll keeps the voter on each vote, shows names,
 * and lets somebody change their mind until it closes.
 * Open while `closedAt` is null and `closesAt` (if any) is in the future — see
 * `src/lib/polls.ts`.
 */
model Poll {
  id             String    @id @default(cuid())
  teamId         String
  postId         String    @unique
  question       String
  anonymous      Boolean   @default(false)
  multipleChoice Boolean   @default(false)
  /// The match a "kampens spiller" vote is about, if any.
  matchId        String?
  closesAt       DateTime?
  closedAt       DateTime?
  createdAt      DateTime  @default(now())

  team    Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  post    Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  match   Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  options PollOption[]
  votes   PollVote[]
  ballots PollBallot[]

  @@index([teamId, createdAt])
  @@index([matchId])
}

/// One answer to choose. `playerId` when the answer is a player on the team. Reached through its poll.
model PollOption {
  id       String  @id @default(cuid())
  pollId   String
  text     String
  playerId String?
  position Int

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  player User?      @relation("PollOptionPlayer", fields: [playerId], references: [id], onDelete: SetNull)
  votes  PollVote[]

  @@index([pollId])
  @@index([playerId])
}

/**
 * One vote for one option. In an anonymous poll `voterId` is null and the row has a
 * random id and no timestamp, so it cannot be traced back to a ballot. Reached through
 * its poll.
 */
model PollVote {
  id       String  @id @default(uuid())
  pollId   String
  optionId String
  voterId  String?

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  voter  User?      @relation("PollVoter", fields: [voterId], references: [id], onDelete: Cascade)

  @@unique([optionId, voterId])
  @@index([pollId])
  @@index([voterId])
}

/**
 * Somebody's answer to a hand-made activity (afslutningsfest, holdtur): coming or not.
 * One row per person per activity; changing one's mind updates it. Activities from
 * KampKlar take no sign-ups.
 */
model ActivitySignup {
  id        String   @id @default(cuid())
  teamId    String
  matchId   String
  userId    String
  going     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([teamId])
  @@index([userId])
}

/**
 * A season that has ended, as "Start ny sæson" summed it up before it deleted the fines,
 * challenges and finished activities (`src/lib/season.ts`). `summary` is a
 * `SeasonSummary`, with names copied in: the people in it may have left the team.
 */
model Season {
  id        String   @id @default(cuid())
  teamId    String
  name      String
  startedAt DateTime
  endedAt   DateTime
  summary   Json
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, endedAt])
}

/// That somebody has voted in a poll — and nothing about what. Reached through its poll.
model PollBallot {
  pollId String
  userId String

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  user User @relation("PollBallot", fields: [userId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId])
}

/// Reached through its post.
model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId])
}

/// Reached through its post.
model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

/**
 * A picture: a full size and a thumbnail, both already shrunk in the browser and measured
 * again on arrival (`src/lib/photo-file.ts`). The bytes are in Supabase Storage when
 * `storageKey` is set (`src/lib/storage.ts`), and in Postgres otherwise.
 */
model Photo {
  id          String   @id @default(cuid())
  teamId      String
  contentType String
  width       Int
  height      Int
  bytes       Bytes?
  thumbWidth  Int
  thumbHeight Int
  thumbBytes  Bytes?
  /// Where the bytes are when they are in storage: `<teamId>/<id>`, with `-thumb` on the small one.
  storageKey  String?
  createdAt   DateTime @default(now())

  team Team @relation("PhotoTeam", fields: [teamId], references: [id], onDelete: Cascade)

  teams        Team[]        @relation("TeamPhoto")
  users        User[]        @relation("UserPhoto")
  postPhotos   PostPhoto[]
  chatMessages ChatMessage[]

  @@index([teamId, createdAt])
}

model LoginAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
